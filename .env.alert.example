# Alert/deletion-propagation-only production settings. It needs R2 solely to
# delete already-authorized raw objects; it must not receive provider tokens,
# deletion-database credentials, or score-ledger keys.
DEMO_MODE=false
DATABASE_URL=postgresql://radar_app:<secret>@postgres.example.com/ai_hot?sslmode=verify-full
REDIS_URL=rediss://redis.example.com/0
R2_ENDPOINT_URL=https://r2.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Required for the Alert identity's short-lived, bucket-scoped R2 credentials.
# Cloudflare R2 exposes Object Read & Write rather than a delete-only grant;
# this process is independently credentialed and its code path only deletes.
R2_SESSION_TOKEN=
RAW_EVIDENCE_BUCKET=ai-hot-raw
WEBHOOK_SIGNING_SECRET=
WEBHOOK_SIGNING_KEY_ID=primary
RADAR_WORKSPACE_IDS=replace-with-workspace-ids
RADAR_INSTANCE_ID=replace-with-stable-alert-instance
ALERT_CONSUMER_NAME=alert-1
ALERT_MAX_DELIVERIES=5
ALERT_CLAIM_MIN_IDLE_MS=60000
