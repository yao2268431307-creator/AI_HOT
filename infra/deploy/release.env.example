# Render to /etc/ai-hot/release.env. This file contains no service secrets.
RADAR_API_IMAGE_REPOSITORY=ghcr.io/your-org/ai-hot-radar-api
RADAR_API_IMAGE_DIGEST=sha256:replace-with-64-lowercase-hex
RADAR_WEB_IMAGE_REPOSITORY=ghcr.io/your-org/ai-hot-radar-web
RADAR_WEB_IMAGE_DIGEST=sha256:replace-with-64-lowercase-hex
RADAR_PUBLIC_API_URL=https://radar-api.example.com
RADAR_PUBLIC_WEB_URL=https://radar.example.com
RADAR_RELEASE_REPOSITORY=your-org/ai-hot-radar
RADAR_RELEASE_COMMIT=replace-with-approved-full-commit-sha
RADAR_RELEASE_MANIFEST_DIGEST=sha256:replace-with-64-lowercase-hex
RADAR_API_ENV_FILE=/etc/ai-hot/api.env
RADAR_SCHEDULER_ENV_FILE=/etc/ai-hot/scheduler.env
RADAR_ALERT_ENV_FILE=/etc/ai-hot/alert.env
RADAR_SOURCE_IDENTITIES_FILE=/etc/ai-hot/source-identities.json
RADAR_RSS_FEEDS_FILE=/etc/ai-hot/rss-feeds.json
RADAR_API_PORT=8017
RADAR_WEB_PORT=3000
