RUNTIME_PROFILE=local
AUTH_REQUIRED=false
RADAR_API_HOST=127.0.0.1
RADAR_API_PORT=8017
RADAR_WEB_HOST=localhost
RADAR_WEB_PORT=3210
CORS_ORIGINS=http://localhost:3210,http://127.0.0.1:3210

DATABASE_URL=postgresql://radar_app:radar-app-local-only@127.0.0.1:5432/ai_hot
DELETION_DATABASE_URL=postgresql://radar_deletion_worker:radar-deletion-local-only@127.0.0.1:5432/ai_hot
RAW_EVIDENCE_LOCAL_DIR=.data/evidence
RAW_EVIDENCE_BUCKET=local-evidence
RAW_EVIDENCE_RETENTION_DAYS=30
RAW_EVIDENCE_MAX_BYTES=21474836480
LOCAL_OUTBOX_BATCH_SIZE=5000

EMBEDDING_BACKEND=local_bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_CACHE_DIR=.data/models/bge-m3
EMBEDDING_RETRY_COOLDOWN_SECONDS=3600
EMBEDDING_LOCAL_FILES_ONLY=true
BGE_M3_DIMENSIONS=1024

FREE_ONLY_MODE=true
EXTERNAL_DATA_BUDGET_RMB=0
EXTERNAL_DATA_SPEND_RMB=0
ENABLED_CONNECTORS=rss,hackernews,github,huggingface,arxiv,bluesky
RSS_FEEDS_FILE=config/feeds.local.json
SOURCE_IDENTITIES_FILE=config/source_identities.local.json
RADAR_WORKSPACE_IDS=local-workspace
BLUESKY_JETSTREAM_ENABLED=true
BLUESKY_JETSTREAM_ENDPOINTS=wss://jetstream2.us-west.bsky.network/subscribe,wss://jetstream1.us-west.bsky.network/subscribe,wss://jetstream2.us-east.bsky.network/subscribe,wss://jetstream1.us-east.bsky.network/subscribe
HF_MAX_ATTEMPTS=1
HF_REQUEST_TIMEOUT_SECONDS=8

# Optional no-billing user credentials. Leave blank to use public limits.
GITHUB_TOKEN=

EVENT_METRIC_RAW_RETENTION_DAYS=180
EVENT_METRIC_ROLLUP_RETENTION_DAYS=730
NEXT_PUBLIC_API_URL=http://127.0.0.1:8017
