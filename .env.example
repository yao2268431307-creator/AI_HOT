# API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_REQUIRED=false
RUNTIME_PROFILE=local
# Deprecated compatibility flag; RUNTIME_PROFILE takes precedence.
DEMO_MODE=false
RADAR_API_HOST=127.0.0.1
RADAR_API_PORT=8017
RADAR_WEB_HOST=127.0.0.1
RADAR_AUTH_MODE=api_keys
# Example: {"local-owner":{"subject":"owner@example.com","role":"OWNER","workspaceId":"workspace-a"}}
RADAR_API_KEYS={}
# Production uses a frozen EdDSA/RS256 public-key map and rejects API-key mode.
RADAR_JWT_PUBLIC_KEYS={}
RADAR_JWT_ISSUER=
RADAR_JWT_AUDIENCE=
DATABASE_URL=postgresql://radar_app:radar-app-local-only@localhost:5432/ai_hot
# Isolated least-privilege credential used only for source-erasure transactions.
DELETION_DATABASE_URL=postgresql://radar_deletion_worker:radar-deletion-local-only@localhost:5432/ai_hot
REDIS_URL=
RAW_EVIDENCE_BUCKET=local-evidence
RAW_EVIDENCE_LOCAL_DIR=.data/evidence
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
WEBHOOK_SIGNING_SECRET=replace-me
WEBHOOK_SIGNING_KEY_ID=primary
RADAR_WORKSPACE_IDS=local-workspace
RADAR_SYSTEM_WORKSPACE_ID=system-governance
# Optional absolute override; blank uses the bundled frozen policy.
PRODUCT_METRIC_POLICY_FILE=
# Client credential used only by tools/acceptance_monitor.py against a protected API.
RADAR_API_KEY=
ACCEPTANCE_MONITOR_BEARER_TOKEN=
# Stable deployment identity returned by /health runtime attestation.
RADAR_INSTANCE_ID=
# Formal acceptance collection must be scheduler-injected. Do not place a
# production private key in this file or in source control.
ACCEPTANCE_MONITOR_ED25519_PRIVATE_KEY=
ACCEPTANCE_MONITOR_ED25519_KEY_ID=
ACCEPTANCE_MONITOR_SCHEDULED_AT=
ACCEPTANCE_MONITOR_RUN_ID=
# Separate API-side signer for complete score-ledger artifacts. It must not
# reuse scheduler/reviewer/baseline key material.
SCORE_LEDGER_ED25519_PRIVATE_KEY=
SCORE_LEDGER_ED25519_KEY_ID=
ALERT_CONSUMER_NAME=alert-1
BGE_M3_BASE_URL=
BGE_M3_API_KEY=
BGE_M3_DIMENSIONS=1024
EMBEDDING_BACKEND=local_bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_CACHE_DIR=.data/models/bge-m3
EMBEDDING_RETRY_COOLDOWN_SECONDS=3600
EMBEDDING_LOCAL_FILES_ONLY=true
RSS_FEEDS_FILE=config/feeds.local.json
SOURCE_IDENTITIES_FILE=config/source_identities.local.json
EXTERNAL_DATA_SPEND_RMB=0
EXTERNAL_DATA_BUDGET_RMB=0
FREE_ONLY_MODE=true
ENABLED_CONNECTORS=rss,hackernews,github,huggingface,arxiv,bluesky
BLUESKY_JETSTREAM_ENABLED=true
BLUESKY_JETSTREAM_ENDPOINTS=wss://jetstream2.us-west.bsky.network/subscribe,wss://jetstream1.us-west.bsky.network/subscribe,wss://jetstream2.us-east.bsky.network/subscribe,wss://jetstream1.us-east.bsky.network/subscribe
HF_MAX_ATTEMPTS=1
HF_REQUEST_TIMEOUT_SECONDS=8
RAW_EVIDENCE_RETENTION_DAYS=30
RAW_EVIDENCE_MAX_BYTES=21474836480
LOCAL_OUTBOX_BATCH_SIZE=5000
# Required in production. Values are monthly RMB hard limits.
CONNECTOR_BUDGETS_RMB_JSON={}
SIGNAL_FAMILY_BUDGETS_RMB_JSON={}
# Metered connectors are fail-closed unless their contracted RMB/request cost
# is explicit. Set 0 only when the account is contractually zero-cost.
CONNECTOR_COST_RMB_GITHUB=
CONNECTOR_COST_RMB_HUGGINGFACE=
CONNECTOR_COST_RMB_OPENALEX=
CONNECTOR_COST_RMB_YOUTUBE=
# Required in production and populated from the release registry, not guessed.
# Example shape: {"api":"sha256:<64 hex>","web":"sha256:<64 hex>"}
RADAR_RELEASE_IMAGE_DIGESTS={}
# Injected by the deployment platform from the actual running OCI manifests;
# it must exactly match RADAR_RELEASE_IMAGE_DIGESTS.
RADAR_ACTUAL_IMAGE_DIGESTS={}
# Deployment image references. Production compose refuses floating tags and
# requires repository@sha256 references for both services.
RADAR_API_IMAGE_REPOSITORY=registry.example.com/signal-ai-radar-api
RADAR_API_IMAGE_DIGEST=sha256:replace-with-64-hex
RADAR_WEB_IMAGE_REPOSITORY=registry.example.com/signal-ai-radar-web
RADAR_WEB_IMAGE_DIGEST=sha256:replace-with-64-hex
RADAR_PUBLIC_API_URL=https://radar-api.example.com
# Production Compose requires three separately permissioned service files.
RADAR_API_ENV_FILE=../.env.api.production
RADAR_SCHEDULER_ENV_FILE=../.env.scheduler.production
RADAR_ALERT_ENV_FILE=../.env.alert.production
RADAR_SOURCE_IDENTITIES_FILE=../config/source_identities.local.json
RADAR_RSS_FEEDS_FILE=../config/feeds.local.json
EVENT_METRIC_RAW_RETENTION_DAYS=180
EVENT_METRIC_ROLLUP_RETENTION_DAYS=730

# Optional official API credentials. Leave absent to disable the connector.
GITHUB_TOKEN=
OPENALEX_API_KEY=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
# Experimental discovery only. Matched records are AppView-verified but stay
# discovery-only until durable update/delete supersession is implemented.
BLUESKY_APPVIEW_ENDPOINT=https://public.api.bsky.app/xrpc/app.bsky.feed.getPosts
BLUESKY_AI_KEYWORDS=AI,LLM,GPT,Claude,Gemini,Qwen,DeepSeek,人工智能,大模型,模型,智能体,多模态
BLUESKY_MAX_MESSAGES=500
BLUESKY_IDLE_TIMEOUT_SECONDS=3

# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:8017
