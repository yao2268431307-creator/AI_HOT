# Independent acceptance-monitor host. Secrets remain in root-owned files.
RADAR_API_URL=https://radar-api.example.com
ACCEPTANCE_OUTPUT=/var/lib/ai-hot-acceptance/soak72h.jsonl
OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth/token
OIDC_CLIENT_ID=replace-with-monitor-client
OIDC_CLIENT_SECRET_FILE=/run/secrets/ai-hot-monitor-oidc-client-secret
OIDC_SCOPE=
OIDC_AUDIENCE=signal-ai-radar
OIDC_AUTH_METHOD=client_secret_basic
ACCEPTANCE_SIGNING_KEY_ID=replace-with-scheduler-key-id
ACCEPTANCE_SIGNING_PRIVATE_KEY_FILE=/run/secrets/ai-hot-monitor-ed25519-private-key-base64
# Optional for the later 7-day product-evidence window. Leave blank for 72H.
ACCEPTANCE_MANUAL_PREREGISTRATION=
ACCEPTANCE_MANUAL_SNAPSHOT=
ACCEPTANCE_EVIDENCE_WINDOW_HOURS=72
ACCEPTANCE_HTTP_TIMEOUT=10
