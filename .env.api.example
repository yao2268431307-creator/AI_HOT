# API-only production settings. Store secrets in the deployment platform and
# render this file with permissions limited to the API workload identity.
DEMO_MODE=false
AUTH_REQUIRED=true
RADAR_AUTH_MODE=jwt
CORS_ORIGINS=https://radar.example.com
DATABASE_URL=postgresql://radar_app:<secret>@postgres.example.com/ai_hot?sslmode=verify-full
DELETION_DATABASE_URL=postgresql://radar_deletion_worker:<secret>@postgres.example.com/ai_hot?sslmode=verify-full
RADAR_JWT_PUBLIC_KEYS={}
RADAR_JWT_ISSUER=https://identity.example.com
RADAR_JWT_AUDIENCE=signal-ai-radar
RADAR_INSTANCE_ID=replace-with-stable-api-instance
RADAR_SYSTEM_WORKSPACE_ID=system-governance
PRODUCT_METRIC_POLICY_FILE=/app/config/product_metric_policy.json
SCORE_LEDGER_ED25519_PRIVATE_KEY=
SCORE_LEDGER_ED25519_KEY_ID=
EXTERNAL_DATA_BUDGET_RMB=2000
CONNECTOR_BUDGETS_RMB_JSON={}
SIGNAL_FAMILY_BUDGETS_RMB_JSON={}
RADAR_RELEASE_IMAGE_DIGESTS={}
