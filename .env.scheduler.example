# Collection/scheduler-only production settings. Do not place deletion,
# webhook-signing, or score-ledger credentials in this file.
DEMO_MODE=false
AUTH_REQUIRED=true
RADAR_AUTH_MODE=jwt
DATABASE_URL=postgresql://radar_app:<secret>@postgres.example.com/ai_hot?sslmode=verify-full
REDIS_URL=rediss://redis.example.com/0
R2_ENDPOINT_URL=https://r2.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional for short-lived, action-scoped S3/R2 credentials.
R2_SESSION_TOKEN=
RAW_EVIDENCE_BUCKET=ai-hot-raw
RADAR_INSTANCE_ID=replace-with-stable-scheduler-instance
SOURCE_IDENTITIES_FILE=/run/config/source_identities.json
RADAR_JWT_PUBLIC_KEYS={}
RADAR_JWT_ISSUER=https://identity.example.com
RADAR_JWT_AUDIENCE=signal-ai-radar
EXTERNAL_DATA_SPEND_RMB=0
EXTERNAL_DATA_BUDGET_RMB=2000
CONNECTOR_BUDGETS_RMB_JSON={}
SIGNAL_FAMILY_BUDGETS_RMB_JSON={}
RADAR_RELEASE_IMAGE_DIGESTS={}
GITHUB_TOKEN=
OPENALEX_API_KEY=
OPENALEX_MAILTO=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
BGE_M3_BASE_URL=
BGE_M3_API_KEY=
BGE_M3_DIMENSIONS=1024
RSS_FEEDS_FILE=/run/config/feeds.json
