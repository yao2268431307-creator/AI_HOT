{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-ai.local/schemas/manual-product-preregistration-v2.json",
  "title": "AI Radar manual evaluation preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productMetricPolicyVersion",
    "productMetricPolicyDigest",
    "selectionRuleVersion",
    "inclusionRules",
    "exclusionRules",
    "snapshotScheduleId",
    "snapshotTimezone",
    "snapshotLocalTime",
    "leadEligibilityRuleVersion",
    "thresholdVersion",
    "baselineDefinitionId",
    "bootstrapSeed",
    "bootstrapIterations",
    "bootstrapUnit",
    "preregisteredAt",
    "schedulerKeyId",
    "schedulerSignature"
  ],
  "properties": {
    "schemaVersion": {"const": "manual-product-preregistration-v2"},
    "productMetricPolicyVersion": {"type": "string", "minLength": 8},
    "productMetricPolicyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "selectionRuleVersion": {"type": "string", "minLength": 8},
    "inclusionRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
    "exclusionRules": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
    "snapshotScheduleId": {"type": "string", "minLength": 8},
    "snapshotTimezone": {"const": "Asia/Shanghai"},
    "snapshotLocalTime": {"const": "09:00"},
    "leadEligibilityRuleVersion": {"type": "string", "minLength": 8},
    "thresholdVersion": {"type": "string", "minLength": 8},
    "baselineDefinitionId": {"type": "string", "minLength": 8},
    "bootstrapSeed": {"type": "integer"},
    "bootstrapIterations": {"type": "integer", "minimum": 1000, "maximum": 100000},
    "bootstrapUnit": {"const": "daily_snapshot"},
    "preregisteredAt": {"type": "string", "format": "date-time"},
    "schedulerKeyId": {"type": "string", "minLength": 8},
    "schedulerSignature": {"type": "string", "minLength": 80}
  }
}
